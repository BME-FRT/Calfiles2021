[2023_Speed]

vx_kmph = *(#v_x, 3.6)
vx_kmph = Set(DIM = 'km/h')

[WheelSpeed_1]

IfExists(#SD_NMech_1)
WheelSpeed_1=*(#SD_NMech_1,Parameters.RPM2KMPH)
WheelSpeed_1=/(#WheelSpeed_1,3.6)
WheelSpeed_1=Set(DIM='m/s')

[WheelSpeed_2]

IfExists(#SD_NMech_2)
WheelSpeed_2=*(#SD_NMech_2,Parameters.RPM2KMPH)
WheelSpeed_2=/(#WheelSpeed_2,3.6)
WheelSpeed_2=Set(DIM='m/s')

[WheelSpeed_3]

IfExists(#SD_NMech_3)
WheelSpeed_3=*(#SD_NMech_3,Parameters.RPM2KMPH)
WheelSpeed_3=/(#WheelSpeed_3,3.6)
WheelSpeed_3=Set(DIM='m/s')

[WheelSpeed_4]

IfExists(#SD_NMech_4)
WheelSpeed_4=*(#SD_NMech_4,Parameters.RPM2KMPH)
WheelSpeed_4=/(#WheelSpeed_4,3.6)
WheelSpeed_4=Set(DIM='m/s')

[Distance]

Dist=Integrate(#vx_kmph)
Dist=Set(DIM='m')

[Throttle_Brake]
// for the GNSS circuit map
Brake_temp=If(#Brake_Force_sensor,<,#VDC_BFS_Offset,0,#Brake_Force_sensor)
Throttle_Brake=+(#APPS1_position,#Brake_temp)
Delete(#Brake_temp)


