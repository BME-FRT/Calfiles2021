[AddtionalInformation]
; During various vehicle development runs, it is necessary to evaluate measurement data only at certain measuring points on the measurement track.
; For the above-mentioned purposes, 2D has developed the special CAL-Files 2D_GPSTracks, with which trigger positions are generated by the Latitude
; And Longitude channels during the analysis of the data, which can then be converted into various measurement tracks.
; The measuring points And tracks thus generated are thus much better suited in the Analyzer for linking to the actual vehicle measurement data
; And thus for further processing than the pure Latitude And Longitude values, since the measuring points And tracks are then available as individual channels.

; In this calculation file the trigger points are defined, which can either already be used for layout purposes Or can be connected to a measuring track in a subsequent CAL file.
; When executing this calculation file, channels (#D_N, #Dx_N, #Dy_N) are created which contain information how far the current position in Analyzer, selected by current cursor position,
; is away from defined trigger point.
; Also, channels (#InKoordinate, #InKoordinate_N, #AtKoordinate, #AtKoordinate_N) are created, which are different parameters, like radius Or minmal distance to trigger centre, of the defined trigger position.

; For more detailed information about the functions of 2D_GPS_Pos_Office2D.CAL And 2D_GPS_Tracks_Office2D.CAL calculation files
; And how to use them, please see the detailed manual "2D_GPSTracks" at download area at our website https://2d-datarecording.com/en/downloads/manuals/

[Variables]

K1_Lat    = 49.00313017                                                         ; Define Trigger point 1
K1_Lon    = 8.46145530
Delta_1   = 2

K2_Lat    = 49.00327717                                                         ; Define Trigger point 2
K2_Lon    = 8.46161200
Delta_2   = 2

K3_Lat    = 49.00331797                                                         ; Define Trigger point 3
K3_Lon    = 8.46154670
Delta_3   = 1.5

K4_Lat    = 49.00367127                                                         ; Define Trigger point 4
K4_Lon    = 8.46136190
Delta_4   = 2.5

K5_Lat    = 49.00360797                                                         ; Define Trigger point 5
K5_Lon    = 8.46131670
Delta_5   = 1

K6_Lat    = 49.00352607                                                         ; Define Trigger point 6
K6_Lon    = 8.46131690
Delta_6   = 1

;K7_Lat    = #CH5_Latitude
;K7_Lon    = #CH5_Longitude
;Delta_7   = 0.1

[Call_2DDistanceAndTimeCH]
{$IfNotExists(#Distance2D) <UserDataDir>\Calfiles\2DCalfiles\2D_DistanceAndTimeCH, P()}


[ResetfoundKoordinates]
; reset all found Koordinates
InKoordinate           = Const(0,#Distance2D.Rate)                              ; Initialize InKoordiante
AtKoordinate           = Const(0,#Distance2D.Rate)                              ; Initialize AtKoordiante
DistanceFromKoordinate = Const(0,#Distance2D.Rate)                              ; Initialize DistanceFromKoordinate

[Latitude]
Result                 = Freq(#Latitude, #Distance2D.Rate)

[Longitude]
Result                 = Freq(#Longitude,#Distance2D.Rate)

[Altitude]
IfOrgExists(#Altitude)
NewResult              = Freq(#Altitude ,#Distance2D.Rate)

[Altitude_NotExists]
IfNotOrgExists(#Altitude)
Altitude               = Freq(#Altitude ,#Distance2D.Rate)

[Call_2D_GPS_DXDY]
{$I <UserDataDir>\Calfiles\2DCalfiles\_2D_GPS_DXDY, P( @K1_Lat,@K1_lon ,1, @Delta_1)}  ; Create Trigger point 1
{$I <UserDataDir>\Calfiles\2DCalfiles\_2D_GPS_DXDY, P( @K2_Lat,@K2_lon ,2, @Delta_2)}  ; Create Trigger point 2
{$I <UserDataDir>\Calfiles\2DCalfiles\_2D_GPS_DXDY, P( @K3_Lat,@K3_lon ,3, @Delta_3)}  ; Create Trigger point 3
{$I <UserDataDir>\Calfiles\2DCalfiles\_2D_GPS_DXDY, P( @K4_Lat,@K4_lon ,4, @Delta_4)}  ; Create Trigger point 4
{$I <UserDataDir>\Calfiles\2DCalfiles\_2D_GPS_DXDY, P( @K5_Lat,@K5_lon ,5, @Delta_5)}  ; Create Trigger point 5
{$I <UserDataDir>\Calfiles\2DCalfiles\_2D_GPS_DXDY, P( @K6_Lat,@K6_lon ,6, @Delta_6)}  ; Create Trigger point 6
;{$I <UserDataDir>\Calfiles\2DCalfiles\_2D_GPS_DXDY, P( @K7_Lat,@K7_lon ,7, @Delta_7)}  ; Create Trigger point 6


