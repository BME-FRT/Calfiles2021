[2023_Yaw]

/////Cornering radius
c_radius=Power(#v_x, 2)
c_radius=/(#c_radius,#AccY_Bosch)
c_radius=/(#c_radius,9.81)
c_radius=F(#c_radius,F(AVG 20))
c_radius=Set(Dim='m')
c_radius=Limit(#c_radius, -100, 100)

{$IfNotExists(#Steering_Angle_1) 2023_Throttle_Steering.CAL}

Wheel_Angle_Real=/(#Steering_Angle_1,Parameters.STEERING_RATIO)
Wheel_Angle_Real_rad=*(#Wheel_Angle_Real,@DEG2RAD)
Wheel_Angle_Real_rad=Set(Dim='rad')

Wheel_Angle_Virtual=/(Parameters.WHEELBASE,#c_radius)    // Wheel_Angle_Virtual=ArcTan(Wheelbase/c_radius)
Wheel_Angle_Virtual=ArcTan(#Wheel_Angle_Virtual)
Wheel_Angle_Virtual=*(#Wheel_Angle_Virtual,@RAD2DEG)
Wheel_Angle_Virtual=If(#v_x,<,5,#Wheel_Angle_Real,#Wheel_Angle_Virtual)
Wheel_Angle_Virtual=F(#Wheel_Angle_Virtual,F(AVG 10))
Wheel_Angle_Virtual=Set(Dim='°')

Handling=/(#Wheel_Angle_Virtual,#Wheel_Angle_Real)
Handling=-(#Handling,1)
Handling=If(#v_x,>,0.5,#Handling,0)
c1=Abs(#Wheel_Angle_Real)
Handling=If(#c1,<,3,0,#Handling)
Handling=Set(Dim='-')

Delete(#c1)

[Yaw_moment]
{
Yaw=+(#YawRate_Bosch,#YawRate_Bosch)
Yaw=/(#Yaw,2)
Yaw=F(#Yaw,F(AVG 20))
Mz_Real=Derivate(#Yaw)
Mz_Real=*(#Mz_Real,@DEG2RAD)
Mz_Real=*(#Mz_Real,Parameters.I_Z)
Mz_Real=Set(Dim='Nm')

Delete(#Yaw)
}
//Delete(#Mz_Real)

/////Yaw moment calculated from torques at wheelsû

Mz_1=*(#BSW_TrqSp_1,Parameters.PLANETARY_GEAR_RATIO)
Mz_1=*(#Mz_1,Parameters.TRACK_FRONT)
Mz_1=/(#Mz_1,-2)
Mz_1=/(#Mz_1,Parameters.WHEEL_RADIUS)

Mz_2=*(#BSW_TrqSp_2,Parameters.PLANETARY_GEAR_RATIO)
Mz_2=*(#Mz_2,Parameters.TRACK_FRONT)
Mz_2=/(#Mz_2,2)
Mz_2=/(#Mz_2,Parameters.WHEEL_RADIUS)

Mz_3=*(#BSW_TrqSp_3,Parameters.PLANETARY_GEAR_RATIO)
Mz_3=*(#Mz_3,Parameters.TRACK_REAR)
Mz_3=/(#Mz_3,-2)
Mz_3=/(#Mz_3,Parameters.WHEEL_RADIUS)

Mz_4=*(#BSW_TrqSp_4,Parameters.PLANETARY_GEAR_RATIO)
Mz_4=*(#Mz_4,Parameters.TRACK_REAR)
Mz_4=/(#Mz_4,2)
Mz_4=/(#Mz_4,Parameters.WHEEL_RADIUS)

M_Yaw=+(#Mz_1,#Mz_2)
M_Yaw=+(#M_Yaw,#Mz_3)
M_Yaw=+(#M_Yaw,#Mz_4)

Delete(#Mz_1)
Delete(#Mz_2)
Delete(#Mz_3)
Delete(#Mz_4)


[Understeer gradient]
// velocity dependent k_us interpolation
num = -(#VDC_Understeer_Gradient_B, #VDC_Understeer_Gradient_A)
fract = /(#num, 30) //30 m/s is the maximum given velocity in the VDC model
fract1 = *(#fract, #v_x)
K_us_Actual = +(#fract1, #VDC_Understeer_Gradient_A)
Delete(#num)
Delete(#fract)
Delete(#fract1)


[Target_Yaw_Rate]

Target_Yaw_Rate=*(#v_x, #v_x)
Target_Yaw_Rate=*(#Target_Yaw_Rate,#K_us_Actual)
Target_Yaw_Rate=+(#Target_Yaw_Rate,Parameters.WHEELBASE)
Target_Yaw_Rate=/(#v_x,#Target_Yaw_Rate)
Target_Yaw_Rate=*(#Target_Yaw_Rate,#Wheel_Angle_Real)
Target_Yaw_Rate=Set(Dim='1/s')

[AccY m/s^2]
AccY_mpss=*(#AccY_Bosch,9.81)
AccY_mpss=Set(Dim='m/s^2')

